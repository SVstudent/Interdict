# ---- Model access ----
# COMPLIANCE: the competition rules mandate "Gemini 3.5 or newer accessed through Gemini API or
# Vertex AI". `gemini` is the only provider permitted for anything that gets judged. `tokenrouter`
# is a third-party aggregator kept for cheap local iteration ONLY — record mode refuses to run on
# it and a test enforces that. See context/DECISIONS.md D-008.
# vertex     PREFERRED. Uses ADC, the same credential as GEAP. No per-key free-tier RPM ceiling,
#            and aiplatform.googleapis.com is already enabled on the project.
#            Setup: gcloud auth application-default login  +  GCP_PROJECT_ID below.
# gemini     Also compliant. Simpler, but a separate credential and a per-key rate limit.
# tokenrouter DEVELOPMENT ONLY. Record mode refuses to run on it.
LLM_PROVIDER=vertex                   # vertex | gemini | tokenrouter
VERTEX_LOCATION=global
GEMINI_API_KEY=                       # only for LLM_PROVIDER=gemini

# Development-only aggregator. Saves free-tier quota and GCP credits during prompt iteration.
TOKENROUTER_API_KEY=                  # tr_...
TOKENROUTER_BASE_URL=https://api.tokenrouter.io/v1
TOKENROUTER_MODEL_PREFIX=google/      # TokenRouter namespaces models as provider/model
FLASH_MODEL=gemini-3.6-flash
REASONING_MODEL=gemini-3.7-flash      # Challenger + Adjudicator. NOT a Pro model: the only
                                      # Gemini 3.x Pro is 3.1-pro-preview and 3.1 < 3.5 fails
                                      # the mandated version floor. See DECISIONS D-007a.
PRO_MODEL=gemini-3.1-pro-preview      # escape hatch only; setting it breaks rules compliance

# ---- Demo ----
DEMO_MODE=replay                      # live | replay | record

# Where the morning's post comes from.
#   seed   the 25 fixture messages. The default, and what every test and offline replay uses.
#   gmail  a real mailbox, read over IMAP, READ-ONLY. Lets the demo open on messages that
#          actually arrived. See backend/app/platform/mailbox.py for what that does and does
#          not make real, and scripts/send_demo_inbox.py to populate your own inbox first.
# The app password is a credential: put it in .env (gitignored), never here.
# Generate one at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
INBOX_SOURCE=seed                     # seed | gmail
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_FOLDER=INBOX                    # '[Gmail]/Spam' if Gmail files the lures there
GMAIL_MAX_MESSAGES=25
AUTO_RELEASE_CEILING=250000.00
CALLBACK_REQUIRED_THRESHOLD=50000.00
CALLBACK_GRACE_HOURS=48

# Set this to a REAL phone you control and it becomes the vendor's number of record, so the
# recorded demo performs a genuine out-of-band verification on camera. This is the control the
# whole product models: you dial the number the SYSTEM holds, never the one the request supplied.
CALLBACK_DEMO_PHONE=

# ---- GCP / GEAP ----
# NOTE: GEAP components are NOT co-located. See context/DECISIONS.md D-002a.
GCP_PROJECT_ID=
GEAP_RUNTIME_LOCATION=us-central1     # reasoningEngines (Agent Runtime)
GEAP_REGISTRY_LOCATION=global         # agents (Agent Registry)
GEAP_GOVERNANCE_LOCATION=us-central1  # semanticGovernancePolicies
PLATFORM_BACKEND=local                # local | geap

# ---- Local emulators ----
FIRESTORE_EMULATOR_HOST=localhost:8080
PUBSUB_EMULATOR_HOST=localhost:8085
