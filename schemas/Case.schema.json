{
  "$defs": {
    "CaseState": {
      "enum": [
        "opened",
        "held",
        "verifying",
        "awaiting_callback",
        "challenging",
        "adjudicating",
        "escalated",
        "released",
        "blocked"
      ],
      "title": "CaseState",
      "type": "string"
    },
    "ChallengeResult": {
      "properties": {
        "strongest_legitimate_explanation": {
          "title": "Strongest Legitimate Explanation",
          "type": "string"
        },
        "rebuttals": {
          "items": {
            "$ref": "#/$defs/Rebuttal"
          },
          "title": "Rebuttals",
          "type": "array"
        },
        "survived": {
          "title": "Survived",
          "type": "boolean"
        },
        "reasoning": {
          "title": "Reasoning",
          "type": "string"
        }
      },
      "required": [
        "strongest_legitimate_explanation",
        "survived",
        "reasoning"
      ],
      "title": "ChallengeResult",
      "type": "object"
    },
    "Checkpoint": {
      "description": "Written before a step runs and updated after it completes. On restart the runner replays\nthe checkpoint log to decide what it may skip.",
      "properties": {
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "step": {
          "title": "Step",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CheckpointStatus",
          "default": "started"
        },
        "state_before": {
          "$ref": "#/$defs/CaseState"
        },
        "state_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaseState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "output_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "attempt": {
          "default": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        }
      },
      "required": [
        "seq",
        "case_id",
        "step",
        "state_before",
        "input_hash",
        "started_at"
      ],
      "title": "Checkpoint",
      "type": "object"
    },
    "CheckpointStatus": {
      "enum": [
        "started",
        "completed",
        "failed"
      ],
      "title": "CheckpointStatus",
      "type": "string"
    },
    "Decision": {
      "properties": {
        "outcome": {
          "enum": [
            "BLOCK",
            "RELEASE",
            "ESCALATE"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "dissenting_findings": {
          "items": {
            "type": "string"
          },
          "title": "Dissenting Findings",
          "type": "array"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decided_by": {
          "default": "fleet",
          "enum": [
            "fleet",
            "human"
          ],
          "title": "Decided By",
          "type": "string"
        },
        "human_reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Reviewer"
        }
      },
      "required": [
        "outcome",
        "confidence",
        "rationale",
        "decided_at"
      ],
      "title": "Decision",
      "type": "object"
    },
    "EvidenceRef": {
      "properties": {
        "source": {
          "description": "e.g. 'email_headers', 'erp:invoices', 'entity_registry'",
          "title": "Source",
          "type": "string"
        },
        "locator": {
          "description": "where in the source, e.g. 'Reply-To' or 'INV-4471'",
          "title": "Locator",
          "type": "string"
        },
        "excerpt": {
          "description": "the literal observed value, not a summary",
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "source",
        "locator",
        "excerpt"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Finding": {
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "agent_version": {
          "title": "Agent Version",
          "type": "string"
        },
        "signal": {
          "title": "Signal",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "supports",
            "contradicts",
            "inconclusive"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "reasoning": {
          "title": "Reasoning",
          "type": "string"
        },
        "latency_ms": {
          "default": 0,
          "title": "Latency Ms",
          "type": "integer"
        }
      },
      "required": [
        "finding_id",
        "agent",
        "agent_version",
        "signal",
        "verdict",
        "confidence",
        "reasoning"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Rebuttal": {
      "description": "Bound to a specific finding, so BLOCK can ask 'was *this* finding rebutted?' instead of\nconsulting one global survived flag.",
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "argument": {
          "title": "Argument",
          "type": "string"
        },
        "succeeds": {
          "title": "Succeeds",
          "type": "boolean"
        }
      },
      "required": [
        "finding_id",
        "argument",
        "succeeds"
      ],
      "title": "Rebuttal",
      "type": "object"
    }
  },
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "tenant_id": {
      "default": "riverbend",
      "title": "Tenant Id",
      "type": "string"
    },
    "vendor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vendor Id"
    },
    "state": {
      "$ref": "#/$defs/CaseState",
      "default": "opened"
    },
    "exposure_amount": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Exposure Amount"
    },
    "held_payment_ids": {
      "items": {
        "type": "string"
      },
      "title": "Held Payment Ids",
      "type": "array"
    },
    "opened_at": {
      "format": "date-time",
      "title": "Opened At",
      "type": "string"
    },
    "deadline_at": {
      "format": "date-time",
      "title": "Deadline At",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "challenge": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChallengeResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Decision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "checkpoints": {
      "items": {
        "$ref": "#/$defs/Checkpoint"
      },
      "title": "Checkpoints",
      "type": "array"
    },
    "idempotency_keys": {
      "items": {
        "type": "string"
      },
      "title": "Idempotency Keys",
      "type": "array"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    }
  },
  "required": [
    "case_id",
    "request_id",
    "opened_at",
    "deadline_at"
  ],
  "title": "Case",
  "type": "object"
}
